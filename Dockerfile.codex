FROM debian:13-slim

ARG CODEX_VERSION=0.163.0
ARG UV_VERSION=0.13.1
ARG PYTORCH_VERSION=2.11.0
ARG PYTORCH_INDEX_URL=https://download.pytorch.org/whl/cu128
ARG VAMPIRE_VERSION=5.1.0
ARG ELAN_VERSION=4.2.4
ARG MATHLIB_REF=v4.35.0
ARG LEAN_TOOLCHAIN=leanprover/lean4:${MATHLIB_REF}
ARG CODEX_GID=1000
ARG CODEX_UID=1000

RUN apt-get update \
    && apt-get install --no-install-recommends -y \
        bash \
        build-essential \
        bubblewrap \
        ca-certificates \
        cadical \
        cargo \
        cmake \
        curl \
        ffmpeg \
        file \
        git \
        golang-go \
        gzip \
        imagemagick \
        jq \
        latexmk \
        less \
        lmodern \
        ninja-build \
        pandoc \
        pkg-config \
        poppler-utils \
        procps \
        python-is-python3 \
        python3 \
        python3-dev \
        python3-pip \
        python3-venv \
        ripgrep \
        rustc \
        tar \
        tesseract-ocr \
        tesseract-ocr-hun \
        texlive-extra-utils \
        texlive-fonts-extra \
        texlive-fonts-recommended \
        texlive-lang-european \
        texlive-latex-base \
        texlive-latex-extra \
        texlive-latex-recommended \
        texlive-science \
        tidy \
        unzip \
        xz-utils \
    && groupadd --gid "$CODEX_GID" codex \
    && useradd --create-home --gid codex --shell /bin/bash --uid "$CODEX_UID" codex

# Keep pip installations separate from Debian's managed Python packages.
RUN python3 -m venv /opt/venv \
    && /opt/venv/bin/python -m pip install numpy "torch==${PYTORCH_VERSION}" --index-url "$PYTORCH_INDEX_URL" \
    && chown -R codex:codex /opt/venv

# Invoke the venv interpreter directly: symlinks to it do not preserve the
# venv prefix when shells replace PATH. Keep Debian's /usr/bin tools intact.
RUN for tool in python python3 pip pip3; do \
        printf '#!/bin/sh\nexec /opt/venv/bin/%s "$@"\n' "$tool" > "/usr/local/bin/$tool" \
        && chmod 0755 "/usr/local/bin/$tool" \
        || exit 1; \
    done \
    && PATH=/usr/local/bin:/usr/bin:/bin python -c 'import sys, torch; assert sys.prefix == "/opt/venv"; assert torch.ones(2).sum().item() == 2; print(torch.__version__)' \
    && PATH=/usr/local/bin:/usr/bin:/bin pip check

RUN curl --fail --location --silent --show-error \
        "https://github.com/astral-sh/uv/releases/download/${UV_VERSION}/uv-x86_64-unknown-linux-gnu.tar.gz" \
        --output /tmp/uv.tar.gz \
    && mkdir /tmp/uv \
    && tar --extract --file /tmp/uv.tar.gz --gzip --directory /tmp/uv \
    && install --mode 0755 /tmp/uv/uv-x86_64-unknown-linux-gnu/uv /usr/local/bin/uv \
    && install --mode 0755 /tmp/uv/uv-x86_64-unknown-linux-gnu/uvx /usr/local/bin/uvx \
    && uv --version \
    && rm -rf /tmp/uv /tmp/uv.tar.gz

RUN curl --fail --location --silent --show-error \
        "https://github.com/openai/codex/releases/download/rust-v${CODEX_VERSION}/codex-package-x86_64-unknown-linux-musl.tar.gz" \
        --output /tmp/codex.tar.gz \
    && mkdir /opt/codex \
    && tar --extract --file /tmp/codex.tar.gz --gzip --no-same-owner --directory /opt/codex \
    && ln -s /opt/codex/bin/codex /usr/local/bin/codex \
    && ln -s /opt/codex/bin/codex-code-mode-host /usr/local/bin/codex-code-mode-host \
    && codex --version \
    && rm -f /tmp/codex.tar.gz

RUN curl --fail --location --silent --show-error \
        "https://github.com/vprover/vampire/releases/download/v${VAMPIRE_VERSION}/vampire-Linux-X64.zip" \
        --output /tmp/vampire.zip \
    && mkdir /tmp/vampire \
    && unzip -q /tmp/vampire.zip -d /tmp/vampire \
    && install --mode 0755 /tmp/vampire/vampire /usr/local/bin/vampire \
    && rm -rf /tmp/vampire /tmp/vampire.zip

# Install stable entry points in addition to PATH configuration below. This
# keeps Lean usable if an interactive environment replaces PATH.
RUN mkdir /opt/elan /opt/mathlib \
    && chown codex:codex /opt/elan /opt/mathlib \
    && ln -s /opt/elan/bin/elan /usr/local/bin/elan \
    && ln -s /opt/elan/bin/lean /usr/local/bin/lean \
    && ln -s /opt/elan/bin/lake /usr/local/bin/lake

COPY --chmod=0755 home/bin/lean-mathlib.sh /usr/local/bin/lean-mathlib.sh

ENV HOME=/home/codex \
    ELAN_HOME=/opt/elan \
    VIRTUAL_ENV=/opt/venv \
    PATH=/home/codex/bin:/opt/venv/bin:/opt/elan/bin:/usr/local/bin:/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin

USER codex

RUN curl --fail --location --silent --show-error \
        "https://github.com/leanprover/elan/releases/download/v${ELAN_VERSION}/elan-x86_64-unknown-linux-gnu.tar.gz" \
        --output /tmp/elan.tar.gz \
    && mkdir /tmp/elan \
    && tar --extract --file /tmp/elan.tar.gz --gzip --directory /tmp/elan \
    && /tmp/elan/elan-init -y --no-modify-path --default-toolchain none \
    && elan toolchain install "$LEAN_TOOLCHAIN" \
    && elan default "$LEAN_TOOLCHAIN" \
    && lean --version \
    && lake --version \
    && lake help comparator \
    && lake help check \
    && bwrap --version \
    && rm -rf /tmp/elan /tmp/elan.tar.gz

RUN git clone --depth 1 --branch "$MATHLIB_REF" \
        https://github.com/leanprover-community/mathlib4.git /opt/mathlib \
    && cd /opt/mathlib \
    && (lake exe cache get || true) \
    && lake build

# Seed each container's private home with all files from the home template.
# Codex state is mounted separately by run-codex.sh and never copied into the image.
COPY --chown=codex:codex home/ /home/codex/

USER codex
RUN mkdir -p /home/codex/.codex /home/codex/workspace
WORKDIR /home/codex/workspace
ENTRYPOINT ["codex"]
