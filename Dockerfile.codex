FROM python:3.12-slim-bookworm

ARG CODEX_VERSION=0.153.0
ARG VAMPIRE_VERSION=5.1.0
ARG ELAN_VERSION=4.2.4
ARG LEAN_TOOLCHAIN=leanprover/lean4:v4.34.0
ARG MATHLIB_REF=v4.34.0
ARG CODEX_GID=1000
ARG CODEX_UID=1000

COPY --from=ghcr.io/astral-sh/uv:0.9.10 /uv /uvx /usr/local/bin/

RUN apt-get update \
    && apt-get install --no-install-recommends -y \
        bash \
        ca-certificates \
        cadical \
        curl \
        file \
        git \
        gzip \
        jq \
        less \
        procps \
        poppler-utils \
        ripgrep \
        tar \
        texlive-latex-base \
        texlive-latex-recommended \
        texlive-latex-extra \
        texlive-lang-european \
        texlive-fonts-recommended \
        texlive-fonts-extra \
        texlive-extra-utils \
        lmodern \
        latexmk \
        ffmpeg \
        tesseract-ocr \
        imagemagick \
        tesseract-ocr-hun \
        tidy \
        unzip \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid "$CODEX_GID" codex \
    && useradd --create-home --gid codex --shell /bin/bash --uid "$CODEX_UID" codex

RUN curl --fail --location --silent --show-error \
        "https://github.com/openai/codex/releases/download/rust-v${CODEX_VERSION}/codex-package-x86_64-unknown-linux-musl.tar.gz" \
        --output /tmp/codex.tar.gz \
    && mkdir /tmp/codex \
    && tar --extract --file /tmp/codex.tar.gz --gzip --directory /tmp/codex \
    && install --mode 0755 /tmp/codex/bin/codex /usr/local/bin/codex \
    && install --mode 0755 /tmp/codex/bin/codex-code-mode-host /usr/local/bin/codex-code-mode-host \
    && codex --version \
    && rm -rf /tmp/codex /tmp/codex.tar.gz

RUN curl --fail --location --silent --show-error \
        "https://github.com/vprover/vampire/releases/download/v${VAMPIRE_VERSION}/vampire-Linux-X64.zip" \
        --output /tmp/vampire.zip \
    && mkdir /tmp/vampire \
    && unzip -q /tmp/vampire.zip -d /tmp/vampire \
    && install --mode 0755 /tmp/vampire/vampire /usr/local/bin/vampire \
    && rm -rf /tmp/vampire /tmp/vampire.zip

# Install stable entry points in addition to PATH configuration below. This
# keeps Lean usable if an interactive environment replaces PATH.
RUN mkdir /opt/elan /opt/mathlib \
    && chown codex:codex /opt/elan /opt/mathlib \
    && ln -s /opt/elan/bin/elan /usr/local/bin/elan \
    && ln -s /opt/elan/bin/lean /usr/local/bin/lean \
    && ln -s /opt/elan/bin/lake /usr/local/bin/lake

COPY --chmod=0755 home/bin/lean-mathlib.sh /usr/local/bin/lean-mathlib.sh

ENV HOME=/home/codex \
    ELAN_HOME=/opt/elan \
    PATH=/home/codex/bin:/opt/elan/bin:/usr/local/bin:/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin

USER codex

RUN curl --fail --location --silent --show-error \
        "https://github.com/leanprover/elan/releases/download/v${ELAN_VERSION}/elan-x86_64-unknown-linux-gnu.tar.gz" \
        --output /tmp/elan.tar.gz \
    && mkdir /tmp/elan \
    && tar --extract --file /tmp/elan.tar.gz --gzip --directory /tmp/elan \
    && /tmp/elan/elan-init -y --no-modify-path --default-toolchain none \
    && elan toolchain install "$LEAN_TOOLCHAIN" \
    && elan default "$LEAN_TOOLCHAIN" \
    && lean --version \
    && lake --version \
    && rm -rf /tmp/elan /tmp/elan.tar.gz

RUN git clone --depth 1 --branch "$MATHLIB_REF" \
        https://github.com/leanprover-community/mathlib4.git /opt/mathlib \
    && cd /opt/mathlib \
    && lake exe cache get || true \
    && lake build

WORKDIR /home/codex/workspace
ENTRYPOINT ["codex"]
